# Copy to .env (or set in your shell). Never commit the real .env file.
PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# ---- Email (optional) ----
# Leave SMTP_HOST empty to print verification/reset links in the backend console.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-character Google App Password> (normal password will not work).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WebSec Checklist <no-reply@example.com>
